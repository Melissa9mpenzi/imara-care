NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-unique-secret-with-npm-run-auth-setup
IMARA_FACILITY_ID=IM
IMARA_FACILITY_NAME=Imara Care Clinic

# Configure SMTP to send invitation emails. Without SMTP, local development
# shows the one-time invitation link to the signed-in administrator.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
