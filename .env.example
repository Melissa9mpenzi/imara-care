# Used by Prisma CLI. Keep this value aligned with backend/.env.
DATABASE_URL=postgresql://imara:replace-with-local-password@localhost:5432/imara_care?schema=public
IMARA_FACILITY_ID=IM
IMARA_FACILITY_SLUG=imara-care
IMARA_FACILITY_NAME=Imara Care Clinic

# Required to deliver password-reset OTPs and staff invitations by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
